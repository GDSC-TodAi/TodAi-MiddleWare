PORT=8080

# RabbitMQ (Slow Track)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EMOTION_QUEUE=todai.worker.emotion
RABBITMQ_STT_QUEUE=todai.worker.stt
RABBITMQ_REPLY_QUEUE=todai.reply
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=3

# Spring Backend internal API (비어있으면 비활성화)
BACKEND_BASE_URL=
BACKEND_REQUEST_TIMEOUT_SECONDS=3

# Fast Track — STT (Whisper tiny HTTP server)
STT_BASE_URL=http://localhost:9001
STT_TIMEOUT_SECONDS=5

# Fast Track — LLM (Ollama compatible)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=10

# Fast Track — TTS
TTS_BASE_URL=http://localhost:9002
TTS_TIMEOUT_SECONDS=5

# Fast Track 전체 timeout (STT+LLM+TTS 합산)
FAST_TRACK_TIMEOUT_SECONDS=8

# ADK (Google ADK agent HTTP server, 비어있으면 비활성화)
ADK_BASE_URL=
ADK_TIMEOUT_SECONDS=10
